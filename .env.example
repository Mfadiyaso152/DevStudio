# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Resend Email Service Configuration
RESEND_API_KEY="re_xxxxxxxxxxxx"
RESEND_FROM_EMAIL="DevStudio <no-reply@devstudio.sa>"

# Firebase Admin Configuration (Optional for Custom Tokens)
FIREBASE_PROJECT_ID="dev-studi"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@dev-studi.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FIREBASE_SERVICE_ACCOUNT_KEY=""

# Security Salt for OTP Hashing
OTP_SALT="devstudio_secure_otp_salt_2026"
